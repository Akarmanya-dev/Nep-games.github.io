// Cloudflare settings for the Changa Chait room server. Deploy with: npx wrangler deploy
{
  "name": "nep-games-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan needs SQLite-backed Durable Objects, even though rooms store nothing.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
